# ============================================================
# Legal RAG Backend - Environment Variables (EXAMPLE)
# ============================================================
# Copy sang .env và điền giá trị thật:
#   cp .env.example .env
# ⚠️  KHÔNG commit file .env lên git!
# ============================================================


# ── LLM API (cho Evol-Instruct) ──────────────────────────────
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_NAME=meta-llama-3.1-8b-instruct
EVOL_TEMPERATURE=0.85
ANSWER_TEMPERATURE=0.1
MAX_TOKENS=2048
TOP_P=0.9
CONTEXT_LENGTH=8192

# ── HuggingFace Dataset ──────────────────────────────────────
HF_DATASET_NAME=th1nhng0/vietnamese-legal-documents

# ── Pinecone (Vector DB) ──────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=legal-rag-vi
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DIM=768

# ── Neo4j (Graph DB) ─────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# ── Pipeline Settings ─────────────────────────────────────────
MAX_SEEDS=0
MAX_RETRIES=3
SIMILARITY_THRESHOLD=0.95
BATCH_SIZE=10

# ── Data Paths (mặc định đã đúng, chỉ sửa nếu muốn override) ──
# RAG pipeline
RAW_DATA_DIR=data/rag/raw
PROCESSED_DATA_DIR=data/rag/processed
INDEXES_DIR=data/rag/indexes
# Evol-Instruct pipeline
SEEDS_DIR=data/evol_instruct/seeds
OUTPUT_DIR=data/evol_instruct/output

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# ============================================
# Evol-Instruct Pipeline - Git Ignore
# ============================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- Data (large files, generated) ---
# RAG pipeline data
backend/data/rag/raw/
backend/data/rag/processed/
backend/data/rag/indexes/
# Evol-Instruct data
backend/data/evol_instruct/seeds/
backend/data/evol_instruct/output/
# Wildcard cho mọi file lớn
*.jsonl
*.pkl

# --- Docker ---
# (docker-compose.yml và Dockerfile ĐƯỢC commit)
# Nhưng không commit Docker volumes hay build cache

# --- Logs ---
logs/
*.log

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Model Files (quá lớn) ---
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# --- HuggingFace Cache ---
.cache/
~/.cache/huggingface/

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- Misc ---
*.bak
*.tmp
*.temp

# --- QA Specificity Pipeline (Phần 3) ---
# *.json / *.jsonl ở trên chặn toàn cục nên deliverables mặc định không lên git.
backend/data/qa_pairs/raw/
backend/data/qa_pairs/labeled/
!backend/data/qa_pairs/final/
!backend/data/qa_pairs/final/*.json

# Nguồn corpus luật dân sự do người dùng tự thả vào (QA_CORPUS_SOURCE).
# Không đẩy lên git: dung lượng lớn, và bản quyền nguồn thì tuỳ nơi tải về.
backend/data/corpus_civil/*
!backend/data/corpus_civil/README.md

# File override tuỳ chọn của Phần 3 (nếu muốn tách API key judge khỏi .env chung).
# Không bắt buộc — mặc định cứ để JUDGE_* trong .env ở root là đủ.
backend/config/qa.env

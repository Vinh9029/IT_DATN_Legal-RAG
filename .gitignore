# ============================================
# Evol-Instruct Pipeline - Git Ignore
# ============================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- Data (large files, generated) ---
data/raw/
data/output/
data/seeds/
*.jsonl
*.json
!config/*.json

# --- Logs ---
logs/
*.log

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Model Files (quá lớn) ---
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# --- HuggingFace Cache ---
.cache/
~/.cache/huggingface/

# --- Testing ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- Misc ---
*.bak
*.tmp
*.temp

#Other...
ai-agent-workspace-pack-main/

# --- QA Specificity Pipeline (Phần 3) ---
# *.json / *.jsonl ở trên chặn toàn cục nên deliverables mặc định không lên git.
!data/qa_pairs/final/
!data/qa_pairs/final/*.json

# Nguồn corpus luật dân sự do người dùng tự thả vào (QA_CORPUS_SOURCE).
# Không đẩy lên git: dung lượng lớn, và bản quyền nguồn thì tuỳ nơi tải về.
data/corpus_civil/*
!data/corpus_civil/README.md

# File override tuỳ chọn của Phần 3 (nếu muốn tách API key judge khỏi .env chung).
# Không bắt buộc — mặc định cứ để JUDGE_* trong .env ở root là đủ.
config/qa.env

# ============================================
# Evol-Instruct Pipeline - Environment Config (EXAMPLE)
# ============================================
# Copy file này thành .env và điền giá trị phù hợp:
#   cp .env.example .env

# --- LLM API Configuration (LM Studio) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_NAME=meta-llama-3.1-8b-instruct

# --- Temperature Settings ---
EVOL_TEMPERATURE=0.85
ANSWER_TEMPERATURE=0.1

# --- Generation Parameters ---
MAX_TOKENS=2048
TOP_P=0.9
CONTEXT_LENGTH=8192

# --- HuggingFace Dataset ---
HF_DATASET_NAME=th1nhng0/vietnamese-legal-documents
HF_DATASET_CONFIG=content

# --- Pipeline Settings ---
MAX_SEEDS=0
MAX_RETRIES=3
SIMILARITY_THRESHOLD=0.95
BATCH_SIZE=10

# --- Output Paths ---
OUTPUT_DIR=data/output
SEEDS_DIR=data/seeds
RAW_DATA_DIR=data/raw

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
